{
  "name": "dsh-token-gauge",
  "version": "1.0.0",
  "description": "Car-dashboard style Token gauge for DeepSeek Harness: live token speed, session/today usage, spend and cache hit rate, with four skins and two layouts.",
  "displayName": "费用仪表盘 / Token Gauge",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "screenshots/*.png"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token",
    "token-usage",
    "token-cost",
    "gauge",
    "dashboard",
    "sidebar",
    "cache-hit-rate",
    "web-ui"
  ],
  "author": "liumiaozhi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liumiaozhi/dsh-token-gauge.git"
  },
  "homepage": "https://github.com/liumiaozhi/dsh-token-gauge#readme",
  "bugs": {
    "url": "https://github.com/liumiaozhi/dsh-token-gauge/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@kenz1117/dsh-ui-usage-billing": ">=1.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
